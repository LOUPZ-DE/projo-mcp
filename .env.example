# ─── Server ──────────────────────────────────────────────────────────────────
# Öffentliche Basis-URL dieses Servers (ohne Slash am Ende). Muss exakt der URL entsprechen, die Clients nutzen
# (Issuer-Match!). Lokal: http://localhost:3000 – produktiv z. B. https://projo-mcp.example.com
BASE_URL=http://localhost:3000
PORT=3000

# Anzeigename (serverInfo.name, /.well-known/mcp.json, HTML-Seiten)
# SERVER_NAME=projo-mcp

# Je mindestens 32 Zeichen, z. B.: openssl rand -base64 48
TOKEN_SECRET=change-me-token-secret-min-32-chars-please
SESSION_SECRET=change-me-session-secret-min-32-chars-please

# Lebensdauer Access-Token in Sekunden (Standard 3600) und Refresh-Token (Standard 30 Tage)
# ACCESS_TOKEN_TTL=3600
# REFRESH_TOKEN_TTL=2592000

# Datenverzeichnis: OAuth-Zustand, verschlüsselter Sitzungs-Tresor, Audit-Log. Docker: /data (Volume)
# DATA_DIR=./data
# Registrierte OAuth-Clients + Refresh-Tokens über Neustarts hinweg behalten
# STATE_FILE=./data/state.json

# ─── Anmeldung an DIESEM MCP-Server (wer ist die Person?) ────────────────────
# Komma-separiert: local, google, entra
#   local = Test-Nutzer aus USERS_JSON (Klartext-Passwörter – nur für lokale Tests!)
#   entra = Microsoft Entra ID (Single-Tenant) – empfohlen für Organisationen mit Microsoft 365
AUTH_PROVIDERS=local
USERS_JSON=[{"email":"test@example.com","password":"test1234","name":"Test User"}]

# Google Cloud Console → Credentials → OAuth-Client-ID (Web), Redirect-URI: https://<host>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Entra Admin Center → App-Registrierungen (Single-Tenant). Redirect-URIs (Web):
#   https://<host>/auth/entra/callback
#   https://<host>/connect/auth/entra/callback
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# Allowlist für SSO-Anmeldungen (komma-separiert). Sind beide leer, darf sich jedes Konto des IdP anmelden.
# SSO_ALLOWED_DOMAINS=example.com
# SSO_ALLOWED_EMAILS=alice@example.com,bob@example.com

# ─── projo ───────────────────────────────────────────────────────────────────
# projo-Web-App
# PROJO_BASE_URL=https://my.projo.berlin

# Schlüssel des Sitzungs-Tresors (AES-256-GCM): genau 32 Byte, base64. Pflicht.
# Erzeugen: openssl rand -base64 32 – geht er verloren, müssen alle Nutzer projo neu verbinden.
VAULT_KEY=

# Nutzer dürfen ihr projo-Passwort verschlüsselt speichern lassen (Opt-in, nur Passwort-Login) → stille Neuanmeldung
# PROJO_STORE_PASSWORDS=true
# Microsoft-Cookies nach einem SSO-Connect behalten (stille SSO-Neuanmeldung, aber größere Angriffsfläche)
# PROJO_KEEP_MS_COOKIES=false
# „Mit Microsoft verbinden“ auf der Verbindungsseite anbieten (braucht Chromium – im Image enthalten)
# PROJO_MS_CONNECT=true

# Keep-alive: jede verbundene projo-Sitzung alle N Stunden auffrischen (projo verlängert sein 14-Tage-Cookie). 0 = aus
# KEEPALIVE_HOURS=24
# Ungenutzte HTTP-Sitzungen / Browser-Kontexte pro Nutzer nach N Millisekunden schließen
# SESSION_IDLE_MS=900000
# BROWSER_IDLE_MS=300000
# BROWSER_MAX_CONTEXTS=3
# PROJO_USER_AGENT=

# ─── Optional: LLM-Router für Ausweich-Extraktion / Reparaturvorschläge ───────
# Aus, solange REQUESTY_API_KEY leer ist. Jeder OpenAI-kompatible Endpunkt funktioniert.
# Bei personenbezogenen Daten: EU-Endpunkt, nur EU-Modelle freigeben, Request-Logging abschalten.
# REQUESTY_API_KEY=
# REQUESTY_BASE_URL=https://router.eu.requesty.ai/v1
# REQUESTY_MODEL=policy/projo-heal
