{
  "name": "projo-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Inoffizieller MCP-Server für projo (my.projo.berlin): Zeiten, Abwesenheiten und Projektführung per Web-Automatisierung",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dev.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:flow": "./scripts/test-flow.sh",
    "selftest": "node dist/selftest.js",
    "discover": "tsx scripts/discover.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "async-mutex": "^0.5.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "jose": "^6.2.7",
    "openai": "^7.45.1",
    "playwright": "1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "projo",
    "time-tracking",
    "playwright",
    "oauth2",
    "dcr"
  ]
}
